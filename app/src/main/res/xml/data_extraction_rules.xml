<?xml version="1.0" encoding="utf-8"?>
<!-- The Keystore key that unwraps the logins keyset never leaves this device, so the keyset and logins file are useless anywhere else. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/logins.enc" />
        <exclude domain="sharedpref" path="logins_keyset_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/logins.enc" />
        <exclude domain="sharedpref" path="logins_keyset_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
