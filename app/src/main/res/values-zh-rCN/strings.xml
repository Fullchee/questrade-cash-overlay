    <string name="app_name">Questrade 现金显示</string>
    <string name="accessibility_service_description">读取 Questrade 下单页面上所选的账户，以显示该账户的现金。</string>
    <string name="onboarding_restricted_settings_title">允许受限设置</string>
    <string name="onboarding_restricted_settings_body">在“应用信息”中，打开 ⋮ 菜单，点按“允许受限设置”。只有这样，Android 才会让您开启下一步。</string>
    <string name="onboarding_accessibility_title">无障碍</string>
    <string name="onboarding_accessibility_body">开启“Questrade 现金显示”，让它能读取 Questrade 下单页面上的账户。</string>
    <string name="onboarding_notifications_title">通知</string>
    <string name="onboarding_notifications_body">允许通知，这样当登录需要重新连接时，应用可以提醒您。</string>
    <string name="onboarding_battery_title">电池</string>
    <string name="onboarding_battery_body">将电池使用设为“无限制”，以免 HyperOS 停止每日刷新。</string>
    <string name="onboarding_autostart_title">自启动</string>
    <string name="onboarding_autostart_body">在“安全”中为本应用开启自启动，然后勾选下面的方框。</string>
